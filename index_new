</style>
</head>

<body>

<div id="panel">
  <details>
    <summary>Fotogalerij — bediening & afbeeldingen</summary>

    <p>
      Telefoon: joystick = lopen;
      over het beeld slepen = rondkijken;
      kort tikken op een foto = selecteren.
    </p>

    <p>
      Computer: WASD / pijltjes = lopen;
      Shift = sneller;
      muis slepen = rondkijken.
      Je kunt ook de muis vastzetten;
      Esc geeft hem vrij.
    </p>

    <button id="lock">Muis vastzetten</button>
    <button id="toggle">Joystick tonen/verbergen</button>

    <p>
      Selecteer een foto en vervang die tijdelijk door een lokaal bestand:
      <br>
      <input id="upload" type="file" accept="image/*">
      <br>
      <small>
        Er wordt niets geüpload.
        Herladen herstelt de foto's uit de map afbeeldingen.
      </small>
    </p>

    <p>
      Directe albumlinks:
      <br>

      <a
        href="https://photos.app.goo.gl/VvYa1KCkWFjQkYjx8"
        target="_blank"
        rel="noopener noreferrer"
      >Georgië</a>

      ·

      <a
        href="https://photos.app.goo.gl/JpmaoD9XZU9JVygc8"
        target="_blank"
        rel="noopener noreferrer"
      >Bulgarije</a>

      ·

      <a
        href="https://photos.app.goo.gl/nwTJQ991okddfWQU7"
        target="_blank"
        rel="noopener noreferrer"
      >Montenegro</a>
    </p>
  </details>

  <div id="status">3D-bibliotheek laden…</div>
</div>

<div id="cross">+</div>

<div id="stick" aria-label="Virtuele joystick">
  <div id="knob"></div>
  <span>Lopen</span>
</div>

<div id="target">
  <div id="selection">Tik of klik op een foto</div>

  <a
    id="open"
    class="open"
    target="_blank"
    rel="noopener noreferrer"
    hidden
  >Open album ↗</a>

  <div id="hint">Slepen = rondkijken</div>
</div>

<script type="module">
const status = document.querySelector('#status');

document.body.classList.toggle(
  'touch',
  matchMedia('(pointer: coarse)').matches ||
  navigator.maxTouchPoints > 0
);

try {
  const THREE = await import(
    'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js'
  );

  // ============================================================
  // SCÈNE, CAMERA EN RENDERER
  // ============================================================

  const scene = new THREE.Scene();

  scene.background = new THREE.Color(0x182335);
  scene.fog = new THREE.Fog(0x182335, 18, 55);

  const camera = new THREE.PerspectiveCamera(
    70,
    innerWidth / innerHeight,
    0.1,
    100
  );

  camera.position.set(0, 1.7, 6);
  camera.rotation.order = 'YXZ';

  const renderer = new THREE.WebGLRenderer({
    antialias: true
  });

  renderer.setSize(innerWidth, innerHeight);
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

  document.body.appendChild(renderer.domElement);

  const canvas = renderer.domElement;

  // ============================================================
  // VERLICHTING
  // ============================================================

  scene.add(
    new THREE.HemisphereLight(
      0xdcecff,
      0x454238,
      1.5
    )
  );

  const sun = new THREE.DirectionalLight(
    0xffffff,
    1.5
  );

  sun.position.set(5, 10, 4);
  scene.add(sun);

  // ============================================================
  // PROCEDURELE TEXTURES
  // ============================================================

  function createGrassTexture() {
    const textureCanvas = document.createElement('canvas');

    textureCanvas.width = 512;
    textureCanvas.height = 512;

    const ctx = textureCanvas.getContext('2d');

    let seed = 1970;

    function random() {
      seed = (
        Math.imul(seed, 1664525) + 1013904223
      ) >>> 0;

      return seed / 4294967296;
    }

    ctx.fillStyle = '#486b32';
    ctx.fillRect(0, 0, 512, 512);

    const groundColors = [
      '#42612d',
      '#517738',
      '#5b7d3d',
      '#3b5929',
      '#687d3d'
    ];

    for (let i = 0; i < 18000; i++) {
      ctx.fillStyle = groundColors[
        Math.floor(random() * groundColors.length)
      ];

      ctx.fillRect(
        random() * 512,
        random() * 512,
        1 + random() * 4,
        1 + random() * 4
      );
    }

    const bladeColors = [
      '#789347',
      '#658a3e',
      '#8ca257',
      '#355426',
      '#486b2c',
      '#a0a766'
    ];

    ctx.lineWidth = 1;

    for (let i = 0; i < 16000; i++) {
      const x = random() * 512;
      const y = random() * 512;

      const dx = (random() - 0.5) * 5;
      const dy = -2 - random() * 7;

      ctx.strokeStyle = bladeColors[
        Math.floor(random() * bladeColors.length)
      ];

      // Ook over de randen tekenen voor een doorlopend patroon.
      for (const offsetX of [-512, 0, 512]) {
        for (const offsetY of [-512, 0, 512]) {
          const startX = x + offsetX;
          const startY = y + offsetY;

          if (
            startX < -8 ||
            startX > 520 ||
            startY < -10 ||
            startY > 522
          ) {
            continue;
          }

          ctx.beginPath();
          ctx.moveTo(startX, startY);
          ctx.lineTo(startX + dx, startY + dy);
          ctx.stroke();
        }
      }
    }

    const texture = new THREE.CanvasTexture(textureCanvas);

    texture.colorSpace = THREE.SRGBColorSpace;
    texture.wrapS = THREE.RepeatWrapping;
    texture.wrapT = THREE.RepeatWrapping;

    // Het patroon herhaalt zich iedere twee meter.
    texture.repeat.set(25, 25);

    texture.anisotropy = Math.min(
      8,
      renderer.capabilities.getMaxAnisotropy()
    );

    return texture;
  }

  function createRetroTileTexture() {
    const textureCanvas = document.createElement('canvas');

    textureCanvas.width = 512;
    textureCanvas.height = 512;

    const ctx = textureCanvas.getContext('2d');
    const tileSize = 256;

    // Voegen tussen de tegels.
    ctx.fillStyle = '#776b58';
    ctx.fillRect(0, 0, 512, 512);

    const palettes = [
      ['#e6d4a5', '#b9652e', '#72503a', '#d5a344'],
      ['#dcc38b', '#d18738', '#785139', '#eee0b8'],
      ['#e7d6ac', '#8b603b', '#c47732', '#d4a34d'],
      ['#d8bd89', '#bd642e', '#6a4935', '#ebd7a7']
    ];

    for (let row = 0; row < 2; row++) {
      for (let col = 0; col < 2; col++) {
        const x = col * tileSize;
        const y = row * tileSize;

        const colors = palettes[row * 2 + col];

        ctx.fillStyle = colors[0];
        ctx.fillRect(x + 3, y + 3, 250, 250);

        ctx.save();

        ctx.beginPath();
        ctx.rect(x + 3, y + 3, 250, 250);
        ctx.clip();

        const cornerX = col === row
          ? x
          : x + tileSize;

        const cornerY = row === 0
          ? y
          : y + tileSize;

        const radii = [282, 220, 158, 96];

        const bands = [
          colors [aframe](https://aframe.io/docs/1.8.0/components/link.html),
          colors [doc.babylonjs](https://doc.babylonjs.com/features/featuresDeepDive/babylonViewer/hotspots/),
          colors [threejs](https://threejs.org/docs/pages/Raycaster.html),
          colors[0]
        ];

        for (let i = 0; i < radii.length; i++) {
          ctx.fillStyle = bands[i];

          ctx.beginPath();

          ctx.arc(
            cornerX,
            cornerY,
            radii[i],
            0,
            Math.PI * 2
          );

          ctx.fill();
        }

        ctx.restore();

        ctx.strokeStyle = '#ffffff22';
        ctx.lineWidth = 2;
        ctx.strokeRect(x + 5, y + 5, 246, 246);
      }
    }

    const texture = new THREE.CanvasTexture(textureCanvas);

    texture.colorSpace = THREE.SRGBColorSpace;
    texture.wrapS = THREE.RepeatWrapping;
    texture.wrapT = THREE.RepeatWrapping;

    // Twee tegels per texturezijde.
    // Binnenvloer 8 × 6 meter: tegels van 50 × 50 cm.
    texture.repeat.set(8, 6);

    texture.anisotropy = Math.min(
      8,
      renderer.capabilities.getMaxAnisotropy()
    );

    return texture;
  }

  // ============================================================
  // BUITENVLOER: GRAS
  // ============================================================

  const floor = new THREE.Mesh(
    new THREE.PlaneGeometry(50, 50),
    new THREE.MeshStandardMaterial({
      map: createGrassTexture(),
      roughness: 1,
      metalness: 0
    })
  );

  floor.rotation.x = -Math.PI / 2;
  scene.add(floor);

  // ============================================================
  // MUREN EN SELECTIEOBJECTEN
  // ============================================================

  const links = [];
  const pickables = [];
  const obstacles = [];
  const loadingErrors = [];

  const wallMaterial = new THREE.MeshStandardMaterial({
    color: 0xd6d8d1,
    roughness: 1
  });

  // Eén eenheid = één meter.
  // De botsingsdetectie is bedoeld voor horizontale/verticale muren.
  function wall(
    x1,
    z1,
    x2,
    z2,
    height = 2.8,
    thickness = 0.15
  ) {
    const length = Math.hypot(x2 - x1, z2 - z1);

    const mesh = new THREE.Mesh(
      new THREE.BoxGeometry(length, height, thickness),
      wallMaterial
    );

    mesh.position.set(
      (x1 + x2) / 2,
      height / 2,
      (z1 + z2) / 2
    );

    mesh.rotation.y = -Math.atan2(
      z2 - z1,
      x2 - x1
    );

    scene.add(mesh);
    mesh.updateMatrixWorld(true);

    obstacles.push(
      new THREE.Box3().setFromObject(mesh)
    );

    pickables.push(mesh);

    return mesh;
  }

  // Kamer: 8 meter breed en 6 meter diep.
  wall(-4, -3, 4, -3);
  wall(-4, -3, -4, 3);
  wall(4, -3, 4, 3);

  // Voorwand met deuropening van 1,4 meter.
  wall(-4, 3, -0.7, 3);
  wall(0.7, 3, 4, 3);

  const lintel = new THREE.Mesh(
    new THREE.BoxGeometry(1.4, 0.5, 0.15),
    wallMaterial
  );

  lintel.position.set(0, 2.55, 3);

  scene.add(lintel);
  pickables.push(lintel);

  // ============================================================
  // PLAFOND
  // ============================================================

  const ceiling = new THREE.Mesh(
    new THREE.PlaneGeometry(8, 6),
    new THREE.MeshStandardMaterial({
      color: 0xbac1c5,
      roughness: 1,
      side: THREE.DoubleSide
    })
  );

  ceiling.rotation.x = Math.PI / 2;
  ceiling.position.set(0, 2.8, 0);

  scene.add(ceiling);
  pickables.push(ceiling);

  // ============================================================
  // BINNENVLOER: JAREN-70-TEGELS
  // ============================================================

  const roomFloor = new THREE.Mesh(
    new THREE.PlaneGeometry(8, 6),
    new THREE.MeshStandardMaterial({
      map: createRetroTileTexture(),
      roughness: 0.6,
      metalness: 0
    })
  );

  roomFloor.rotation.x = -Math.PI / 2;
  roomFloor.position.y = 0.025;

  scene.add(roomFloor);

  // ============================================================
  // BINNENVERLICHTING
  // ============================================================

  const lamp = new THREE.PointLight(
    0xffefd5,
    45,
    14,
    2
  );

  lamp.position.set(0, 2.5, 0);
  scene.add(lamp);

  const lampMesh = new THREE.Mesh(
    new THREE.SphereGeometry(0.12, 16, 12),
    new THREE.MeshBasicMaterial({
      color: 0xfff4dc
    })
  );

  lampMesh.position.copy(lamp.position);
  scene.add(lampMesh);

  // ============================================================
  // FOTO'S
  // ============================================================

  function placeholder(title) {
    const textureCanvas = document.createElement('canvas');

    textureCanvas.width = 1200;
    textureCanvas.height = 800;

    const ctx = textureCanvas.getContext('2d');

    ctx.fillStyle = '#23364c';
    ctx.fillRect(0, 0, 1200, 800);

    ctx.fillStyle = 'white';
    ctx.textAlign = 'center';

    ctx.font = 'bold 72px system-ui';
    ctx.fillText(title, 600, 375);

    ctx.font = '30px system-ui';
    ctx.fillText('Foto wordt geladen…', 600, 440);

    const texture = new THREE.CanvasTexture(textureCanvas);
    texture.colorSpace = THREE.SRGBColorSpace;

    return texture;
  }

  function applyTexture(obj, texture) {
    texture.colorSpace = THREE.SRGBColorSpace;

    const oldTexture = obj.material.map;

    obj.material.map = texture;
    obj.material.needsUpdate = true;

    oldTexture?.dispose();

    const ratio = texture.image.width / texture.image.height;
    const width = Math.min(2.4, 1.6 * ratio);
    const height = width / ratio;

    obj.geometry.dispose();

    obj.geometry = new THREE.PlaneGeometry(
      width,
      height
    );
  }

  function picture({
    title,
    url,
    imageUrl,
    x,
    z,
    rotation = 0
  }) {
    const group = new THREE.Group();

    group.position.set(x, 1.65, z);
    group.rotation.y = rotation;

    scene.add(group);

    const frame = new THREE.Mesh(
      new THREE.BoxGeometry(2.52, 1.72, 0.045),
      new THREE.MeshStandardMaterial({
        color: 0x25262b,
        roughness: 0.6
      })
    );

    group.add(frame);

    const image = new THREE.Mesh(
      new THREE.PlaneGeometry(2.4, 1.6),
      new THREE.MeshStandardMaterial({
        map: placeholder(title),
        roughness: 1
      })
    );

    image.position.z = 0.025;
    image.userData = { title, url };

    group.add(image);

    links.push(image);
    pickables.push(image, frame);

    new THREE.TextureLoader().load(
      imageUrl,

      texture => {
        applyTexture(image, texture);
      },

      undefined,

      () => {
        loadingErrors.push(imageUrl);

        status.textContent =
          'Niet geladen: ' + loadingErrors.join(', ');

        console.error(
          'Afbeelding niet geladen:',
          imageUrl
        );

        // Alleen tekenen als de oorspronkelijke canvasplaceholder
        // nog aanwezig is.
        const texture = image.material.map;

        if (texture?.image?.getContext) {
          const ctx = texture.image.getContext('2d');

          ctx.fillStyle = '#23364c';
          ctx.fillRect(0, 405, 1200, 90);

          ctx.fillStyle = '#ffb4a4';
          ctx.textAlign = 'center';
          ctx.font = '28px system-ui';

          ctx.fillText(
            'Foto niet geladen — controleer bestandsnaam en pad',
            600,
            450
          );

          texture.needsUpdate = true;
        }
      }
    );

    return image;
  }

  // EIGEN AFBEELDINGEN EN ALBUMLINKS

  picture({
    title: 'Georgië',
    imageUrl: './afbeeldingen/georgie.jpg',
    url: 'https://photos.app.goo.gl/VvYa1KCkWFjQkYjx8',
    x: 0,
    z: -2.89
  });

  picture({
    title: 'Bulgarije',
    imageUrl: './afbeeldingen/bulgarije.jpg',
    url: 'https://photos.app.goo.gl/JpmaoD9XZU9JVygc8',
    x: -3.89,
    z: 0,
    rotation: Math.PI / 2
  });

  picture({
    title: 'Montenegro',
    imageUrl: './afbeeldingen/montenegro.jpg',
    url: 'https://photos.app.goo.gl/nwTJQ991okddfWQU7',
    x: 3.89,
    z: 0,
    rotation: -Math.PI / 2
  });

  // ============================================================
  // BEDIENING EN SELECTIE
  // ============================================================

  const keys = new Set();
  const raycaster = new THREE.Raycaster();
  const point = new THREE.Vector2();

  const selection = document.querySelector('#selection');
  const open = document.querySelector('#open');
  const hint = document.querySelector('#hint');
  const lockButton = document.querySelector('#lock');
  const stick = document.querySelector('#stick');
  const knob = document.querySelector('#knob');

  let yaw = 0;
  let pitch = 0;

  let selected = null;
  let look = null;

  let joyId = null;
  let joyX = 0;
  let joyY = 0;

  let previous = performance.now();

  const locked = () => (
    document.pointerLockElement === canvas
  );

  function rotate(dx, dy) {
    yaw -= dx * 0.003;

    pitch = THREE.MathUtils.clamp(
      pitch - dy * 0.003,
      -1.45,
      1.45
    );

    camera.rotation.set(pitch, yaw, 0);
  }

  function pick(x, y) {
    camera.updateMatrixWorld();
    scene.updateMatrixWorld(true);

    point.set(x, y);

    raycaster.setFromCamera(
      point,
      camera
    );

    const first = raycaster.intersectObjects(
      pickables,
      false
    )[0]?.object;

    // Een muur of kader blokkeert foto's die erachter liggen.
    return first?.userData.url
      ? first
      : null;
  }

  function select(obj) {
    selected = obj;

    selection.textContent = obj
      ? obj.userData.title
      : 'Geen foto geselecteerd';

    open.hidden = !obj;

    if (obj) {
      open.href = obj.userData.url;
    } else {
      open.removeAttribute('href');
    }
  }

  // ============================================================
  // MUIS VASTZETTEN
  // ============================================================

  lockButton.onclick = async () => {
    try {
      if (!canvas.requestPointerLock) {
        throw new Error(
          'Muis vastzetten niet beschikbaar; gebruik slepen of de joystick.'
        );
      }

      await canvas.requestPointerLock();
    } catch (error) {
      status.textContent = error.message;
    }
  };

  document.addEventListener('pointerlockchange', () => {
    keys.clear();
    look = null;

    hint.textContent = locked()
      ? 'Richt op een foto en klik; de muis wordt vrijgegeven.'
      : 'Slepen = rondkijken';
  });

  document.addEventListener('mousemove', event => {
    if (locked()) {
      rotate(
        event.movementX,
        event.movementY
      );
    }
  });

  // ============================================================
  // SLEPEN OM ROND TE KIJKEN, TIKKEN OM TE SELECTEREN
  // ============================================================

  canvas.addEventListener('pointerdown', event => {
    if (
      locked() ||
      look ||
      event.button !== 0
    ) {
      return;
    }

    look = {
      id: event.pointerId,
      x: event.clientX,
      y: event.clientY,
      startX: event.clientX,
      startY: event.clientY,
      moved: false
    };

    canvas.setPointerCapture(event.pointerId);
  });

  canvas.addEventListener('pointermove', event => {
    if (
      locked() ||
      !look ||
      event.pointerId !== look.id
    ) {
      return;
    }

    const dx = event.clientX - look.x;
    const dy = event.clientY - look.y;

    const distance = Math.hypot(
      event.clientX - look.startX,
      event.clientY - look.startY
    );

    if (distance > 8) {
      look.moved = true;
    }

    if (look.moved) {
      rotate(dx, dy);
    }

    look.x = event.clientX;
    look.y = event.clientY;
  });

  canvas.addEventListener('pointerup', event => {
    if (
      !look ||
      look.id !== event.pointerId
    ) {
      return;
    }

    if (!look.moved) {
      const rect = canvas.getBoundingClientRect();

      const x =
        ((event.clientX - rect.left) / rect.width) * 2 - 1;

      const y =
        1 - ((event.clientY - rect.top) / rect.height) * 2;

      select(pick(x, y));
    }

    look = null;
  });

  canvas.addEventListener('pointercancel', () => {
    look = null;
  });

  canvas.addEventListener('lostpointercapture', () => {
    look = null;
  });

  canvas.addEventListener('click', () => {
    if (locked()) {
      select(pick(0, 0));
      document.exitPointerLock();
    }
  });

  // ============================================================
  // TOETSENBORD
  // ============================================================

  const codes = [
    'KeyW',
    'KeyA',
    'KeyS',
    'KeyD',
    'ArrowUp',
    'ArrowDown',
    'ArrowLeft',
    'ArrowRight',
    'ShiftLeft',
    'ShiftRight'
  ];

  const interactiveTags = [
    'INPUT',
    'TEXTAREA',
    'SELECT',
    'BUTTON',
    'A',
    'SUMMARY'
  ];

  document.addEventListener('keydown', event => {
    if (
      !codes.includes(event.code) ||
      interactiveTags.includes(event.target.tagName)
    ) {
      return;
    }

    event.preventDefault();
    keys.add(event.code);
  });

  document.addEventListener('keyup', event => {
    keys.delete(event.code);
  });

  // ============================================================
  // TOUCHJOYSTICK
  // ============================================================

  function resetJoy() {
    joyId = null;
    joyX = 0;
    joyY = 0;

    knob.style.transform = 'translate(0px, 0px)';
  }

  function updateJoy(event) {
    const rect = stick.getBoundingClientRect();
    const radius = (rect.width - 48) / 2 - 4;

    let x =
      event.clientX - rect.left - rect.width / 2;

    let y =
      event.clientY - rect.top - rect.height / 2;

    const length = Math.hypot(x, y);

    if (length > radius) {
      x *= radius / length;
      y *= radius / length;
    }

    joyX = x / radius;
    joyY = y / radius;

    knob.style.transform = `translate(${x}px, ${y}px)`;
  }

  stick.addEventListener('pointerdown', event => {
    if (joyId !== null) {
      return;
    }

    event.preventDefault();

    joyId = event.pointerId;

    stick.setPointerCapture(event.pointerId);

    updateJoy(event);
  });

  stick.addEventListener('pointermove', event => {
    if (event.pointerId === joyId) {
      updateJoy(event);
    }
  });

  for (const name of [
    'pointerup',
    'pointercancel',
    'lostpointercapture'
  ]) {
    stick.addEventListener(name, event => {
      if (event.pointerId === joyId) {
        resetJoy();
      }
    });
  }

  document.querySelector('#toggle').onclick = () => {
    resetJoy();
    document.body.classList.toggle('touch');
  };

  // ============================================================
  // INVOER RESETTEN
  // ============================================================

  function resetInput() {
    keys.clear();
    look = null;
    resetJoy();
  }

  window.addEventListener('blur', resetInput);

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      resetInput();
    }
  });

  open.addEventListener('click', resetInput);

  // ============================================================
  // TIJDELIJK EEN LOKALE FOTO KIEZEN
  // ============================================================

  document.querySelector('#upload').addEventListener(
    'change',
    event => {
      const file = event.target.files[0];
      const obj = selected;

      if (!file) {
        return;
      }

      if (!obj) {
        status.textContent =
          'Selecteer eerst een foto aan de muur.';

        event.target.value = '';
        return;
      }

      const url = URL.createObjectURL(file);

      new THREE.TextureLoader().load(
        url,

        texture => {
          applyTexture(obj, texture);

          URL.revokeObjectURL(url);

          status.textContent =
            'Foto tijdelijk vervangen: ' + obj.userData.title;
        },

        undefined,

        () => {
          URL.revokeObjectURL(url);

          status.textContent =
            'Afbeelding kon niet worden geladen.';
        }
      );

      event.target.value = '';
    }
  );

  // ============================================================
  // VENSTERGROOTTE
  // ============================================================

  window.addEventListener('resize', () => {
    resetInput();

    camera.aspect = innerWidth / innerHeight;
    camera.updateProjectionMatrix();

    renderer.setSize(innerWidth, innerHeight);
  });

  // ============================================================
  // BOTSINGSDETECTIE
  // ============================================================

  function canStand(x, z) {
    const radius = 0.25;

    if (
      Math.abs(x) > 24 ||
      Math.abs(z) > 24
    ) {
      return false;
    }

    return !obstacles.some(box => (
      x > box.min.x - radius &&
      x < box.max.x + radius &&
      z > box.min.z - radius &&
      z < box.max.z + radius
    ));
  }

  status.textContent =
    'Loop over het gras rechtdoor door de deur. Tik op een foto.';

  // ============================================================
  // ANIMATIE EN BEWEGING
  // ============================================================

  function animate(now) {
    requestAnimationFrame(animate);

    const dt = Math.min(
      (now - previous) / 1000,
      0.05
    );

    previous = now;

    let forward =
      Number(
        keys.has('KeyW') ||
        keys.has('ArrowUp')
      ) -
      Number(
        keys.has('KeyS') ||
        keys.has('ArrowDown')
      ) -
      joyY;

    let side =
      Number(
        keys.has('KeyD') ||
        keys.has('ArrowRight')
      ) -
      Number(
        keys.has('KeyA') ||
        keys.has('ArrowLeft')
      ) +
      joyX;

    const length = Math.max(
      1,
      Math.hypot(forward, side)
    );

    forward /= length;
    side /= length;

    const fast =
      keys.has('ShiftLeft') ||
      keys.has('ShiftRight');

    const speed = (fast ? 8 : 4) * dt;

    const dx = (
      -Math.sin(yaw) * forward +
      Math.cos(yaw) * side
    ) * speed;

    const dz = (
      -Math.cos(yaw) * forward -
      Math.sin(yaw) * side
    ) * speed;

    // Kleine stappen voorkomen dat je door dunne muren springt.
    const steps = Math.max(
      1,
      Math.ceil(Math.hypot(dx, dz) / 0.08)
    );

    for (let i = 0; i < steps; i++) {
      const nextX = camera.position.x + dx / steps;

      if (canStand(nextX, camera.position.z)) {
        camera.position.x = nextX;
      }

      const nextZ = camera.position.z + dz / steps;

      if (canStand(camera.position.x, nextZ)) {
        camera.position.z = nextZ;
      }
    }

    const hovered = locked()
      ? pick(0, 0)
      : null;

    for (const obj of links) {
      const glow = obj === selected
        ? 0x333333
        : obj === hovered
          ? 0x181818
          : 0;

      obj.material.emissive.setHex(glow);
    }

    if (locked()) {
      hint.textContent = hovered
        ? 'Klik om ' + hovered.userData.title + ' te selecteren'
        : 'Richt op een foto';
    }

    renderer.render(scene, camera);
  }

  requestAnimationFrame(animate);

} catch (error) {
  status.textContent =
    'Laden mislukt. Controleer internet/WebGL: ' + error.message;

  console.error(error);
}
</script>

